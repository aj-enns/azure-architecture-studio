{
  "name": "azure-architecture-review",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hostable Azure architecture diagram builder for ARB processes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "diagram:solution": "pnpm --filter @aas/shared build && node tools/generate-solution-diagram.mjs",
    "catalog:sync": "pnpm --filter @aas/catalog-sync sync"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.70.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@3.1.4": "3.1.6",
      "fast-uri@4.1.1": "4.1.3"
    }
  }
}
