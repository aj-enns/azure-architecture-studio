server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # SPA fallback: serve index.html for client-side routes.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Proxy API + health calls to the API. API_UPSTREAM is substituted at container
  # start (nginx envsubst): http://api:8080 for docker-compose, or the internal
  # Container Apps name (http://aas-api) in Azure. Only ${API_UPSTREAM} is
  # replaced; nginx runtime vars like $host are left untouched.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_read_timeout 130s;
    proxy_send_timeout 130s;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /healthz {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
  }
}
