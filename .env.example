# ---- API server (apps/api) ----
# Port the API listens on
PORT=8080
# Comma-separated list of allowed CORS origins for the web app
CORS_ORIGIN=http://localhost:5173
# Maximum requests accepted from one client during each rate-limit window
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
IAC_IMPORT_ENABLED=true

# ---- AI provider (bring-your-own) ----
# Choose one configuration. Phase 2 (AI prompt-to-diagram) is disabled when
# both configurations are blank.
#
# Microsoft Foundry model endpoint (recommended for Foundry deployments).
# The endpoint is the resource endpoint, not the project endpoint. The API
# adds /models/chat/completions and sends the model name in the request body.
# infra/setup.ps1 also reads these three non-secret Foundry settings.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_MODEL=
# ARM resource ID used to discover review-compatible deployments. Discovery
# always uses DefaultAzureCredential and needs deployments/read permission.
# Leave blank to offer only AZURE_FOUNDRY_MODEL in the review panel.
AZURE_FOUNDRY_RESOURCE_ID=
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
AZURE_FOUNDRY_API_KEY=
# Leave the Foundry API key blank to use Microsoft Entra ID instead.
#
# Azure OpenAI-compatible endpoint (legacy/alternative configuration).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
#
# Auth: two options.
#  1) API key — set AZURE_OPENAI_API_KEY below.
#  2) Keyless (Microsoft Entra ID) — leave AZURE_OPENAI_API_KEY BLANK. The API
#     acquires a token via DefaultAzureCredential: `az login` locally, or a
#     managed identity when running in Azure. Grant that identity the
#     "Cognitive Services OpenAI User" role on the Azure OpenAI resource.
#     Use this when your org disallows API keys.
AZURE_OPENAI_API_KEY=

# ---- Grounding (Microsoft Learn) ----
# Retrieval-augmented grounding pulls current Azure Architecture Center / Learn
# docs into the generation prompt. Set to "false" to disable. The endpoint is
# the public Microsoft Learn MCP server; override only for a private mirror.
LEARN_GROUNDING_ENABLED=true
LEARN_MCP_ENDPOINT=https://learn.microsoft.com/api/mcp

# ---- Web app (apps/web) ----
# Base URL the browser uses to reach the API
VITE_API_BASE_URL=http://localhost:8080
